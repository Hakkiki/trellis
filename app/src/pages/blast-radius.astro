---
import BlastRadius from "@/components/sim/BlastRadius.tsx";
import AppLayout from "@/layouts/AppLayout.astro";
---

<AppLayout title="Trellis — Blast radius" description="The same bad upgrade, two ways: a shared service (100% blast radius) vs one instance per division (contained).">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold">The blast radius, made visible</h1>
    <p class="text-muted-foreground mt-1 max-w-3xl text-sm">
      The same bad upgrade, two ways. With <b>one shared service</b> every division depends on, a single
      bad change takes down the whole org. With <b>one instance per division</b>, the same change is
      contained to one — and recovers from its own last-good version. This is the core of
      <a class="text-primary underline" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/docs/the-case`}>the case</a>,
      made tangible. (An illustration, not the full engine.)
    </p>
  </div>
  <BlastRadius client:only="react" />
</AppLayout>

---
import AppLayout from "@/layouts/AppLayout.astro";
import Promotion from "@/components/sim/Promotion.tsx";
---

<AppLayout title="Trellis — Promotion" description="Advance an immutable, validated version through dev → staging → prod.">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold">Promotion pipeline</h1>
    <p class="text-muted-foreground mt-1 max-w-3xl text-sm">
      Cut an <b>immutable, validated version</b> and promote it through dev → staging → prod. Each
      environment instantiates the <i>same</i> version with its own posture overrides (dev = C3 … prod =
      C0) and re-plans the path against its own observed state — so what you validated is what shipped.
      Hand-edit an environment and watch it show as <b>drifted off its version</b>.
    </p>
  </div>
  <Promotion client:only="react" />
</AppLayout>

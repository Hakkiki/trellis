---
import AppLayout from "@/layouts/AppLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pillars = [
  {
    title: "Posture",
    body: "Declare what you want — Intent, Resilience, Budget, Governance — never how. Criticality is one dial that moves them together.",
  },
  {
    title: "Planner",
    body: "Compiles a Posture into a concrete Structure and emits a plan that is a proof: every resource traces to the objective or a named constraint.",
  },
  {
    title: "Reconcile loop",
    body: "A reconciler holds reality equal to the approved Structure forever. Self-healing is just this loop running continuously.",
  },
];

const stress = [
  ["Drift", "An out-of-band edit is detected by provenance, not gap size, and corrected."],
  ["Self-heal", "A failed node is Degraded, then re-provisioned within the approved envelope."],
  ["Fail-safe", "Stale telemetry → Unknown; the loop holds rather than acting blind."],
  ["Break-glass", "A frozen resource suspends reconciliation and owes a ratify-or-revert debt."],
  ["FinOps", "Live cost vs. budget; the planner fails loudly when no realization fits."],
  ["Proof", "Every plan carries its derivation; every action emits an audit record."],
];
---

<AppLayout>
  <section class="py-10 text-center">
    <p class="text-primary text-sm font-medium tracking-wide uppercase">Self-hosted cloud control plane</p>
    <h1 class="mx-auto mt-3 max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
      Declare what you want. A reconciler keeps reality matching it.
    </h1>
    <p class="text-muted-foreground mx-auto mt-4 max-w-2xl">
      <b>Posture → planner → Structure → reconcile loop</b> — manifest-driven, with no magic: every
      action is explainable by the plan that authorized it. This is the interactive simulator and the
      design that grows into the real thing.
    </p>
    <div class="mt-7 flex justify-center gap-3">
      <a
        href={`${base}/simulator`}
        class="bg-primary text-primary-foreground rounded-md px-5 py-2.5 text-sm font-medium hover:opacity-90"
        >Open the simulator</a
      >
      <a
        href={`${base}/docs/overview`}
        class="border-input hover:bg-accent rounded-md border px-5 py-2.5 text-sm font-medium"
        >Read the docs</a
      >
    </div>
  </section>

  <section class="mt-8 grid gap-4 md:grid-cols-3">
    {
      pillars.map((p) => (
        <div class="border-border/60 rounded-xl border p-5">
          <h3 class="text-primary font-semibold">{p.title}</h3>
          <p class="text-muted-foreground mt-2 text-sm">{p.body}</p>
        </div>
      ))
    }
  </section>

  <section class="mt-12">
    <h2 class="text-xl font-semibold">What the simulator stress-tests</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        stress.map(([t, b]) => (
          <div class="bg-card/40 rounded-lg border p-4">
            <div class="text-sm font-medium">{t}</div>
            <p class="text-muted-foreground mt-1 text-sm">{b}</p>
          </div>
        ))
      }
    </div>
  </section>
</AppLayout>

---
import AppLayout from "@/layouts/AppLayout.astro";
import Simulator from "@/components/sim/Simulator.tsx";
---

<AppLayout title="Trellis — Simulator" description="Declare a posture, approve a plan, watch the reconciler heal.">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold">Behavioral simulator</h1>
    <p class="text-muted-foreground mt-1 max-w-3xl text-sm">
      The cloud is <b>simulated</b>; the dynamics are <b>real</b>. Declare a Posture → compile a plan
      that is a proof → approve to mint a scoped credential → watch the reconcile loop converge and
      self-heal. State persists in IndexedDB, so your session survives a reload.
    </p>
  </div>
  <Simulator client:only="react" />
</AppLayout>

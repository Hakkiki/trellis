---
import "@/styles/global.css";
const { title = "Trellis", description = "Posture → planner → Structure → reconcile loop." } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const nav = [
  { href: `${base}/`, label: "Home" },
  { href: `${base}/simulator`, label: "Simulator" },
  { href: `${base}/docs/overview`, label: "Docs" },
];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} />
  </head>
  <body class="min-h-screen">
    <header
      class="border-border/60 bg-background/80 sticky top-0 z-20 flex items-center gap-6 border-b px-5 py-3 backdrop-blur"
    >
      <a href={`${base}/`} class="flex items-center gap-2 font-semibold">
        <span
          class="grid size-6 place-items-center rounded-md"
          style="background:linear-gradient(135deg,#c8a040,#6fbf8f)"
        >
          <span class="text-[13px] text-black">◇</span>
        </span>
        Trellis
      </a>
      <nav class="flex items-center gap-4 text-sm">
        {
          nav.map((n) => (
            <a class="text-muted-foreground hover:text-foreground transition" href={n.href}>
              {n.label}
            </a>
          ))
        }
      </nav>
      <a
        class="text-muted-foreground hover:text-foreground ml-auto text-sm"
        href="https://github.com/hakkiki/trellis">GitHub</a
      >
    </header>
    <main class="mx-auto max-w-7xl px-5 py-8">
      <slot />
    </main>
  </body>
</html>

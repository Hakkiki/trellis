---
import BlastRadius from "@/components/sim/BlastRadius.tsx";
import AppLayout from "@/layouts/AppLayout.astro";
---

<AppLayout title="Trellis — Blast radius" description="One bad change, five beats: redundancy and process can't move the blast radius — only share-nothing partitioning bounds it.">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold">The blast radius, made visible</h1>
    <p class="text-muted-foreground mt-1 max-w-3xl text-sm">
      One bad change, walked through five beats. Watch the blast radius stay pinned at 100% as you apply
      the two fixes leaders reach for — <b>redundancy</b> (active-active, DR) and <b>process</b> (change
      boards, freeze windows) — and only drop when the architecture changes to <b>share-nothing
      partitioning</b> — one cell per line of business (LOB). The number refusing to move is the point. This is the core of
      <a class="text-primary underline" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/docs/the-case`}>the case</a>,
      made tangible. (An illustration, not the full engine.)
    </p>
  </div>
  <BlastRadius client:only="react" />
</AppLayout>

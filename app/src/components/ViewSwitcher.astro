---
// A shared switcher that frames the Simulator and Promotion as two views of one
// tool: the same planner, gate, and reconcile loop, at two altitudes.
const { active } = Astro.props as { active: "simulator" | "promotion" };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const tabs = [
  { id: "simulator", href: `${base}/simulator`, label: "Single environment" },
  { id: "promotion", href: `${base}/promotion`, label: "Release pipeline" },
];
---

<div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
  <div class="border-border/60 inline-flex rounded-lg border p-0.5">
    {
      tabs.map((t) => (
        <a
          href={t.href}
          aria-current={active === t.id ? "page" : undefined}
          class:list={[
            "rounded-md px-3 py-1.5 text-sm transition",
            active === t.id
              ? "bg-accent text-foreground"
              : "text-muted-foreground hover:text-foreground",
          ]}
        >
          {t.label}
        </a>
      ))
    }
  </div>
  <p class="text-muted-foreground text-xs">
    Two views of one loop — the same planner, gate, and reconcile engine, at two altitudes.
  </p>
</div>
